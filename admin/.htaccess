RewriteEngine On

# Redirect trailing slashes
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/$ /$1 [L,R=301]

# Allow direct access to uploaded files but prevent script execution
RewriteRule ^storage/uploads/ - [L]

# Prevent direct access to core logic and private data
RewriteRule ^storage/ - [F,L]
RewriteRule ^core/ - [F,L]
RewriteRule ^modules/ - [F,L]

# Route everything else to index.php if not a file or directory
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]
